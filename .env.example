# Copy this file to `.env` and fill in real values.
# .env is already git-ignored — never commit real secrets.

# --- Core ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Leave unset to use local SQLite (fine for development).
# For production, e.g.: postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Email ---
# In development, leave as console so emails print to the terminal instead of sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FoodHub Ghana <no-reply@foodhub.gh>

# --- Payments (Paystack) ---
# Get test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
